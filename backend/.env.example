# Never paste real keys into Git or the iOS app.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Separate third-party shopping provider key. Photos are never sent to SerpApi.
SERPAPI_API_KEY=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Paste that generated token here AND in the iOS app's Settings.
FITFIND_ACCESS_TOKEN=
HOST=127.0.0.1
PORT=8787
MAX_REQUESTS_PER_MINUTE=20
MAX_CONCURRENT_ANALYSES=2
# A conservative call-attempt cap per process lifetime, NOT a durable dollar cap.
MAX_PROVIDER_CALLS_PER_RUN=50
CACHE_TTL_SECONDS=300

# Each garment search uses 1 Shopping call + at most this many detail calls.
SHOPPING_DETAILS_PER_GARMENT=2
MAX_SHOPPING_CALLS_PER_RUN=50
SHOPPING_CACHE_TTL_SECONDS=300
